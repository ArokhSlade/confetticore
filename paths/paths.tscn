[sub_resource type="GDScript" id="GDScript_042v3"]
script/source = "extends Node2D
class_name Paths

const HexMap = preload(\"res://confetticore_hexagon_tilemaplayer.gd\")

@export var path_marker : PackedScene
@export var hex_map : HexMap

var markers : Array
var mech_paths : Dictionary

func update_mech_path(mech, point_path):
	if (mech_paths.has(mech)):
		var old_path = mech_paths[mech]
		remove_child(old_path)
		old_path.queue_free() #TODO(Gerald 2025 08 22): is this right?
			
	var path = Path.new()
	var trimmed_point_path = point_path.slice(0, mech.move_range)
	path.setup(trimmed_point_path, path_marker, hex_map)
	mech_paths[mech] = path
	add_child(path)
	mech.set_path(path)
	
"

[node name="Paths" type="Node2D"]
script = SubResource("GDScript_042v3")
path_marker = ExtResource("2_4i18l")
